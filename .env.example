# PartyKit geliştirme sunucusu (npm run dev ile birlikte çalışır)
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Docker: tarayıcı PartyKit’e buradan bağlanır (compose’da çoğunlukla localhost:1999).
# Ağdan erişim için önce: NEXT_PUBLIC_PARTYKIT_HOST=IP:1999 docker compose build

# Jira: kimlik bilgisi gerekmez — oda ekranındaki “Jira” modalından girilir; /api/jira/import sunucuda çağrı yapar.
